// }

// datasource db {
//   provider = "postgresql"
// }

datasource db {
  provider = "postgresql"
  // url e directURL vanno su file prisma.config.ts 
  // per la versione v7 di prisma in uso in questo 
  // progetto
  
  // url = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id           String     @id @default(uuid()) // autogenerated
  name        String
  company     String
  description String
  featured   Boolean
  image       String
  price       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clerkId  String
}

